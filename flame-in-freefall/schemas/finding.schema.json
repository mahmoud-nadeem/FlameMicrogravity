{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Finding front matter (content/findings/<slug>.md)",
  "type": "object",
  "required": ["title", "author", "date", "investigations", "pillars", "claim", "evidence", "confidence", "si_assisted"],
  "additionalProperties": false,
  "properties": {
    "title": {"type": "string", "minLength": 8, "maxLength": 120},
    "author": {"type": "string", "pattern": "^[a-z0-9-]+$"},
    "date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "investigations": {"type": "array", "items": {"type": "string", "pattern": "^PSI-[0-9]+$"}, "minItems": 1},
    "pillars": {"type": "array", "items": {"type": "string", "enum": ["prevention", "detection", "suppression"]}, "minItems": 1},
    "habitats": {"type": "array", "items": {"type": "string", "enum": ["spacecraft", "space-station", "moon-base", "pressurized-rover", "mars-base", "spacesuit", "earth"]}},
    "claim": {"type": "string", "minLength": 20, "maxLength": 300, "description": "One sentence, with a number"},
    "evidence": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "required": ["kind", "ref"], "additionalProperties": false,
        "properties": {
          "kind": {"type": "string", "enum": ["computation", "table", "figure", "model", "publication", "psi-metadata"]},
          "ref": {"type": "string", "description": "Repo path, URL or DOI"},
          "note": {"type": "string"}
        }
      }
    },
    "confidence": {"type": "string", "enum": ["high", "medium", "low"]},
    "si_assisted": {"type": "boolean", "description": "Was an AI tool used to produce this finding? (challenge disclosure rule)"},
    "figure": {"type": "string"}
  }
}
