{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Team member",
  "type": "object",
  "required": ["id", "name"],
  "additionalProperties": false,
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9-]+$", "description": "Same as the file name, e.g. mahmoud"},
    "name": {"type": "string", "minLength": 2},
    "role": {"type": "string"},
    "focus": {"type": "string", "description": "What this member works on"},
    "links": {"type": "object", "additionalProperties": {"type": "string", "format": "uri"}}
  }
}
